<?xml version="1.0"?>
<package format="3">
  <name>b2_radar</name>
  <version>0.1.0</version>
  <description>Unitree B2 in unitree_mujoco bridged to ROS 2, and repeatable playback of recorded radar input.</description>
  <maintainer email="maintainer@example.com">TODO</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- b2_bridge also needs unitree_go (unitree_ros2); b2_sim.launch.py uses b2_description and b2_sim_control
       from the B2 dev setup. They are not ROS index packages, so they are not listed here. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
